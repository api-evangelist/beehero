              "content": "Given a list of mac addresses and begin & end dates, BeeHero will return a list of samples (temperature, humidity, bees' in-count and out-count etc) for sensors with these mac addresses between these dates",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sensors",
                "samples"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
